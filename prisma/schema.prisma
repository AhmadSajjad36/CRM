generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  companies     Company[]
  contacts      Contact[]
  leads         Lead[]
  pipelines     Pipeline[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]
  meetings      Meeting[]
  notes         Note[]
  tags          Tag[]
  notifications Notification[]
  auditLogs     AuditLog[]
  deals         Deal[]
  integrations  Integration[]
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role         String         @default("OWNER")
  createdAt    DateTime       @default(now())
  activities   Activity[]
  meetings     Meeting[]
  notes        Note[]
  notifications Notification[]
  auditLogs    AuditLog[]
  assignedLeads Lead[]        @relation("LeadOwner")
  assignedOpportunities Opportunity[] @relation("OpportunityOwner")
  assignedTasks Task[]        @relation("TaskAssignee")
}

model Company {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  website       String?
  phone         String?
  email         String?
  industry      String?
  type          String         @default("PROSPECT")
  location      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  tasks         Task[]
  activities    Activity[]
  meetings      Meeting[]
  notesList     Note[]
  @@index([workspaceId, name])
}

model Contact {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  companyName String?
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status      String         @default("lead")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deals       Deal[]
  leads       Lead[]
  opportunities Opportunity[]
  tasks       Task[]
  activities  Activity[]
  meetings    Meeting[]
  notesList   Note[]
  @@unique([workspaceId, email])
}

model Deal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  value       Int       @default(0)
  stage       String    @default("lead")
  position    Float     @default(0)
  companyName String?
  companyId   String?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([stage, position])
}

model Lead {
  id             String      @id @default(cuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId      String?
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  firstName      String?
  lastName       String?
  title          String?
  email          String?
  phone          String?
  source         String?
  industry       String?
  location       String?
  status         String    @default("NEW")
  priority       String    @default("MEDIUM")
  score          Int       @default(0)
  followUpAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  opportunities  Opportunity[]
  tasks          Task[]
  activities     Activity[]
  notesList      Note[]
  @@index([workspaceId, status, score])
}

model Pipeline {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  isDefault     Boolean        @default(false)
  stages        PipelineStage[]
  opportunities Opportunity[]
  createdAt     DateTime       @default(now())
  @@index([workspaceId])
}

model PipelineStage {
  id            String        @id @default(cuid())
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name          String
  key           String
  position      Int
  probability   Int           @default(0)
  opportunities Opportunity[]
  @@unique([pipelineId, key])
  @@index([pipelineId, position])
}

model Opportunity {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId      String
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name            String
  amount          Float         @default(0)
  probability     Int           @default(0)
  expectedCloseAt DateTime?
  notes           String?
  position        Float         @default(0)
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tasks           Task[]
  activities      Activity[]
  meetings        Meeting[]
  notesList       Note[]
  @@index([workspaceId, stageId, position])
}

model Activity {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  type           String
  subject        String
  description    String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  @@index([workspaceId, occurredAt])
}

model Task {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  dueAt          DateTime?
  priority       String       @default("MEDIUM")
  status         String       @default("TODO")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([workspaceId, status, dueAt])
}

model Meeting {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  notes         String?
  createdAt     DateTime     @default(now())
  @@index([workspaceId, startsAt])
}

model Note {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  content       String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([workspaceId, createdAt])
}

model Tag {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  createdAt   DateTime   @default(now())
  @@unique([workspaceId, slug])
}

model Notification {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String     @default("INFO")
  title       String
  message     String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  @@index([workspaceId, userId, readAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  metadata    String?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  category    String
  enabled     Boolean   @default(false)
  label       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([workspaceId, provider])
  @@index([workspaceId, category])
}
